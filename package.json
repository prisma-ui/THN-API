{
  "name": "thn-api",
  "version": "1.0.0",
  "description": "Unofficial REST API wrapper for The Hacker News (thehackernews.com)",
  "main": "api/index.js",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "build:worker": "esbuild workers/index.js --bundle --outfile=dist/worker.js --format=esm --target=esnext --platform=browser --external:__STATIC_CONTENT_MANIFEST",
    "deploy:worker": "npm run build:worker && wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "swagger-ui-dist": "^5.17.14"
  },
  "keywords": [
    "hacker-news",
    "cybersecurity",
    "api",
    "scraper",
    "serverless"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.21.0"
  }
}